# From @BotFather
BOT_TOKEN=

# Telegram user_id of the single allowed user; handlers silently ignore anyone else
ALLOWED_USER_ID=

# postgresql+psycopg://user:password@host:5432/tonus
DATABASE_URL=

# https://console.anthropic.com/ — used only for the weekly analysis job
ANTHROPIC_API_KEY=

# Optional: path to Gadgetbridge's SQLite export for sleep/steps enrichment.
# Leave unset to skip enrichment entirely.
GADGETBRIDGE_DB_PATH=

# IANA timezone used to resolve check-in dates and the reminder hour
DEFAULT_TIMEZONE=Europe/Warsaw

# Local hour (0-23) at which the reminder job nudges for a missing check-in
CHECKIN_REMINDER_HOUR=21
